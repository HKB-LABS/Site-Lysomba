# Copier en .env.local pour le développement, ou définir sur Vercel.
# Toutes optionnelles : sans elles, le site tourne en mode preview (noindex,
# boutons store inactifs) sur une URL .vercel.app.

# URL canonique du site (hreflang, sitemap, Open Graph)
# NEXT_PUBLIC_SITE_URL=https://lysomba.app

# Mettre à 1 UNIQUEMENT à la mise en ligne officielle pour autoriser Google
# NEXT_PUBLIC_LIVE=

# Lien de la fiche Google Play (bouton inactif tant que vide)
# NEXT_PUBLIC_PLAY_URL=https://play.google.com/store/apps/details?id=...

# Lien App Store (affiche « Bientôt sur iOS » tant que vide)
# NEXT_PUBLIC_APPSTORE_URL=
